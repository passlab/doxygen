#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------

PROJECT_NAME           = "AXPY Example Project"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "An example of AXPY implementation using C++."
OUTPUT_DIRECTORY       = ./docs

#---------------------------------------------------------------------------
# Build related configuration options
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
JAVADOC_AUTOBRIEF      = YES

#---------------------------------------------------------------------------
# Input related configuration options
#---------------------------------------------------------------------------

INPUT                  = ./axpy.cpp
FILE_PATTERNS          = *.cpp *.h
RECURSIVE              = NO
ALIASES += sideeffect="Side Effects:\n"

#---------------------------------------------------------------------------
# Source Browser related configuration options
#---------------------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES

#---------------------------------------------------------------------------
# HTML related configuration options
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_TIMESTAMP         = YES

#---------------------------------------------------------------------------
# XML related configuration options
#---------------------------------------------------------------------------

GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

#---------------------------------------------------------------------------
# Diagrams and graphs related configuration options
#---------------------------------------------------------------------------

HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_GRAPH_MAX_NODES    = 50
DOT_CLEANUP            = NO

#---------------------------------------------------------------------------
# Warnings and logs
#---------------------------------------------------------------------------

WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = ./docs/warnings.log

